{
	"name": "seekbench",
	"version": "0.1.0",
	"private": true,
	"description": "A general-purpose benchmark for search scenarios, to help choose search providers and approaches.",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"seekbench": "node --env-file-if-exists=.env src/cli/index.ts",
		"typecheck": "tsc",
		"lint": "biome check",
		"format": "biome check --write",
		"test": "vitest"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "^3.0.71",
		"ai": "^7.0.143",
		"tldts": "^7.4.18",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@types/node": "^24.19.2",
		"lefthook": "^2.2.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"packageManager": "pnpm@12.14.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.22.0",
			"onFail": "download"
		}
	}
}
